# API origin used by the Capacitor (Android) build.
#
# The packaged WebView serves the UI from https://localhost, so the web default
# "/api/v1" would hit the app bundle instead of the Python backend. Point this at
# an absolute URL before building the APK.
#
# Default below targets the Android emulator, where 10.0.2.2 is the host machine.
# For a real device, copy this file to .env.capacitor.local (gitignored) and use
# the LAN address of the machine running `uv run python app.py`, e.g.
#   VITE_API_URL=http://192.168.1.20:7860/api/v1
VITE_API_URL=http://10.0.2.2:7860/api/v1
